+ EOF
+ 
++# stack values:
++# 1 = constant-enabled
++# 0 = default enabled (either top-level or non-constant #if/#ifdef)
++# -1 = constant-disabled
++$AWK 'BEGIN{
++	level = 0;
++	stack[level] = 0;
++}
++/^#ifdef/{
++	stack[++level] = 0;
++	print;
++	next;
++}
++/^#elif/{
++	print;
++	next;
++}
++/^#if/{
++	level++;
++	sub("[ \t]/[*].*","");
++	if (match($0,"#if[ \t]*1$") > 0)
++		stack[level] = 1;
++	else if (match($0,"#if[ \t]*0$") > 0)
++		stack[level] = -1;
++	else
++		stack[level] = 0;
++	print;
++	next;
++}
++/^#else/{
++	if (stack[level] == 1) {
++		stack[level] = -1;
++	} else if (stack[level] == -1) {
++		stack[level] = 1;
++	}
++	print;
++	next;
++}
++/^#endif/{
++	--level;
++	print;
++	next;
++}
++{
++	if (stack[level] >= 0)
++		print;
++}' | \
+ sed -n -f $ED1 \
+ | sed -e 's/NCURSES_EXPORT(\(.*\)) \(.*\) (\(.*\))/\1 \2(\3)/' \
+ | sed -f $ED2 \
